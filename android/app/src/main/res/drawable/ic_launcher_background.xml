<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: deep navy diagonal gradient
     (dark end toward bottom-right, matching the app theme surfaces). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1B2547"
                android:endColor="#FF080D1E" />
        </aapt:attr>
    </path>
</vector>
